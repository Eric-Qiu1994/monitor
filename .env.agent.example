# 远端 agent 环境变量模板
# 复制为 .env（与 agent.compose.yml 同目录），再改值：
#   cp .env.agent.example .env
#   docker compose -f agent.compose.yml up -d
# 或不复制直接指定：docker compose --env-file .env.agent -f agent.compose.yml up -d

# 【必填】中心 monitor 地址
MONITOR_URL=http://1.2.3.4:8080

# 【必填】上报 token，与中心 monitor 的 .env 中 MONITOR_TOKEN 一致
MONITOR_TOKEN=change-me

# 上报间隔（秒）。后台"系统设置"里改过会覆盖这里的值
MONITOR_INTERVAL=10

# 仪表盘显示名；留空用容器主机名
MONITOR_HOSTNAME=

# 出网代理（socks5://host:port 或 http://host:port）；留空不走代理
MONITOR_PROXY=

# 探测方式兜底：icmp / http / tcp（后台已配置探测目标时以后台为准）
MONITOR_PING_METHOD=icmp
MONITOR_PING_COUNT=3
